DATABASE_URL="postgresql://user:password@localhost:5432/gestion_hotel?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"
PORT=3000
# Origenes permitidos del frontend, separados por coma (opcional:
# en development default http://localhost:5173)
CORS_ORIGINS="http://localhost:5173"

# MercadoPago Argentina
# Crear la app en https://mercadopago.com.ar/developers -> Tus aplicaciones
# y completar MP_APP_ID (APP_ID) y MP_CLIENT_SECRET (Secret Key).
# En la app: registrar MP_REDIRECT_URI exactamente como aca, y el webhook MP_NOTIFICATION_URL.
MP_APP_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI="http://localhost:3000/api/mp/oauth/callback"
# Se envia como config.online.callback_url de cada order, asi que es la URL
# a la que MercadoPago manda las notificaciones. En desarrollo se puede apuntar
# a un tunel (ngrok http 3000) para probar el ciclo completo de pago.
MP_NOTIFICATION_URL="http://localhost:3000/api/mp/webhook"
# Solo desarrollo: access token de prueba de MercadoPago. Si esta cargado, las
# orders se crean con este token y no hace falta conectar la cuenta por OAuth.
# Se ignora por completo en produccion, asi que no lo pongas en .env.production.
MP_TEST_ACCESS_TOKEN=
MP_SITE_URL="https://auth.mercadopago.com"
# Base publica del frontend: destination del comprador al terminar el pago
MP_APP_URL="http://localhost:5173"
MP_TOKEN_ENCRYPTION_KEY="generar-con: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
# Obligatorio en produccion: si falta, el webhook responde 500 y no confirma pagos.
# Es la clave que genera MercadoPago al guardar la config en Tus integraciones -> tu
# app -> Webhooks > Configurar notificaciones ("revelar clave generada"). NO es el
# Secret Key de la app (MP_CLIENT_SECRET) ni una clave autogenerada: con cualquiera
# de las dos el HMAC no coincide y el webhook responde 401 SignatureMismatch.
MP_WEBHOOK_SECRET=

# SMTP para enviar el codigo de verificacion de alta de usuario
# (POST /api/users/send-code). Si SMTP_HOST falta, en development el codigo
# se imprime en la consola del backend; en produccion la ruta responde 500.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hotel Manager <no-reply@tudominio.com>"

# Clave de registro de hoteles (POST /api/users/send-code y /users/register).
# Si esta seteada, ambos endpoints exigen "key" en el body (verificado con
# comparacion timing-safe); vacia = rutas abiertas sin secreto. Coordinar con
# VITE_ALLOW_REGISTER del frontend:
#   cerrado -> REGISTER_KEY seteada + VITE_ALLOW_REGISTER off
#   abierto -> REGISTER_KEY vacia  + VITE_ALLOW_REGISTER on