# Runtime. En Supabase es el pooler en modo transaccion (puerto 6543) con
# ?pgbouncer=true. En dev/local, la DB directa.
DATABASE_URL="postgresql://user:password@localhost:5432/gestion_hotel?schema=public"
# Solo para la CLI de Prisma (migrate/seed): no soporta el pooler transaccional.
# En Supabase es el session pooler (puerto 5432, sin pgbouncer=true).
# Ojo: en Supabase el usuario del pooler es "postgres.<project-ref>", no "postgres".
DIRECT_URL="postgresql://user:password@localhost:5432/gestion_hotel?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"
PORT=3000
# Origenes permitidos del frontend, separados por coma (opcional:
# en development default http://localhost:5173)
CORS_ORIGINS="http://localhost:5173"

# MercadoPago Argentina
# Crear la app en https://mercadopago.com.ar/developers -> Tus aplicaciones
# y completar MP_APP_ID (APP_ID) y MP_CLIENT_SECRET (Secret Key).
# En la app: registrar MP_REDIRECT_URI exactamente como aca, y el webhook MP_NOTIFICATION_URL.
MP_APP_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI="http://localhost:3000/api/mp/oauth/callback"
# Se envia como config.online.callback_url de cada order, asi que es la URL
# a la que MercadoPago manda las notificaciones. En desarrollo se puede apuntar
# a un tunel (ngrok http 3000) para probar el ciclo completo de pago.
MP_NOTIFICATION_URL="http://localhost:3000/api/mp/webhook"
# Solo desarrollo: access token de prueba de MercadoPago. Si esta cargado, las
# orders se crean con este token y no hace falta conectar la cuenta por OAuth.
# Se ignora por completo en produccion, asi que no lo pongas en .env.production.
MP_TEST_ACCESS_TOKEN=
MP_SITE_URL="https://auth.mercadopago.com"
# Base publica del frontend: destination del comprador al terminar el pago
MP_APP_URL="http://localhost:5173"
MP_TOKEN_ENCRYPTION_KEY="generar-con: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
# Obligatorio en produccion: si falta, el webhook responde 500 y no confirma pagos.
# Es la clave que genera MercadoPago al guardar la config en Tus integraciones -> tu
# app -> Webhooks > Configurar notificaciones ("revelar clave generada"). NO es el
# Secret Key de la app (MP_CLIENT_SECRET) ni una clave autogenerada: con cualquiera
# de las dos el HMAC no coincide y el webhook responde 401 SignatureMismatch.
MP_WEBHOOK_SECRET=

# Instagram (Meta) - Instagram Business Login (sin Facebook Page)
# En la app de Meta, producto "Instagram" -> API setup with Instagram login.
# INSTAGRAM_APP_ID e INSTAGRAM_APP_SECRET son el Instagram App ID/Secret (NO el
# Facebook App ID/Secret). Registrar INSTAGRAM_REDIRECT_URI exactamente como aca
# en Business login settings -> OAuth redirect URIs.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/integrations/instagram/callback"
# Verify token del handshake del webhook (hub.verify_token). Tiene que coincidir
# tal cual con el que se carga en Meta -> Webhooks. Si falta, el GET de
# verificacion responde 403 y Meta no acepta la URL.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="change-me"
# Opcionales (defaults de Instagram Login):
# INSTAGRAM_AUTHORIZE_URL="https://www.instagram.com/oauth/authorize"
# INSTAGRAM_TOKEN_URL="https://api.instagram.com/oauth/access_token"
# INSTAGRAM_GRAPH_HOST="https://graph.instagram.com"
# INSTAGRAM_GRAPH_API_URL="https://graph.instagram.com/v26.0"
# A donde vuelve el navegador tras conectar la cuenta (opcional: default
# http://localhost:5173 en dev y la URL de CloudFront en produccion).
INSTAGRAM_FRONTEND_URL="http://localhost:5173"

# Supabase Auth (GoTrue) es el store de credenciales: los usuarios y contrasenias
# viven en el schema auth.users de Supabase. El backend solo usa la service_role
# key (nunca se distribuye al frontend) para firmar en /auth/v1 y crear cuentas
# por la Admin API. Configurar en el dashboard: Confirm email ON, SMTP propio y
# Site URL / Redirect URLs del frontend.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"
# Clave publica (publishable/anon) del proyecto. Se usa solo server-side.
SUPABASE_ANON_KEY="<anon_key>"
# Legacy JWT Secret del proyecto (pagina JWT Signing Keys -> seccion homonima).
# Es el unico secreto HS256 extraible; la signing key actual es asimetrica y su
# parte privada no se puede exportar. Con esta clave el backend firma el token de
# Supabase Realtime que autoriza el canal privado de la bandeja (claim
# company_id). Si falta, /api/realtime/config responde 503 y la bandeja usa el
# polling de respaldo.
SUPABASE_JWT_SECRET="<legacy_jwt_secret>"
# La confirmacion de email la manda Supabase; el alta interna crea cuentas ya
# confirmadas y el auto-registro usa el email de confirmacion del proyecto.

# Clave de registro de hoteles (POST /api/auth/register y /auth/resend-confirmation).
# Si esta seteada, ambos endpoints exigen "key" en el body (verificado con
# comparacion timing-safe); vacia = rutas abiertas sin secreto. Coordinar con
# VITE_ALLOW_REGISTER del frontend:
#   cerrado -> REGISTER_KEY seteada + VITE_ALLOW_REGISTER off
#   abierto -> REGISTER_KEY vacia  + VITE_ALLOW_REGISTER on
# La key no puede ir al frontend (VITE_* es publico en el bundle).
REGISTER_KEY=

# Asistente de IA de la bandeja (Gemini).
# La key se saca gratis en https://aistudio.google.com/apikey. Sin ella el
# backend arranca igual: /api/ai/config responde configured=false, los drafts
# de la bandeja devuelven 503 AI_NOT_CONFIGURED y el auto-reply queda inactivo.
# Opcional: GEMINI_MODEL (default gemini-3.5-flash) y GEMINI_API_URL
# (default https://generativelanguage.googleapis.com/v1beta).
GEMINI_API_KEY=

