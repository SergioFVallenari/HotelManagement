generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users      User[]
  roomTypes  RoomType[]
  rooms      Room[]
  guests     Guest[]
  services   Service[]
  reservations Reservation[]
}

model User {
  id           Int      @id @default(autoincrement())
  username     String
  passwordHash String
  name         String?
  typeId       Int
  companyId    Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  type         UserType @relation(fields: [typeId], references: [id])
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, username])
  @@index([companyId])
}

enum UserRole {
  ADMIN
  RECEPCIONISTA
}

model UserType {
  id    Int      @id @default(autoincrement())
  role  UserRole @unique @default(RECEPCIONISTA)
  users User[]
}

model RoomType {
  id        Int      @id @default(autoincrement())
  name      String
  companyId Int
  rooms     Room[]
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId])
}

model Room {
  id           Int           @id @default(autoincrement())
  number       String
  name         String?
  typeId       Int
  companyId    Int
  capacity     Int           @default(2)
  price        Decimal       @db.Decimal(10, 2)
  amenities    String[]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  type         RoomType      @relation(fields: [typeId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([companyId, number])
  @@index([typeId])
  @@index([companyId])
}

model Guest {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String
  email        String
  companyId    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([companyId, email])
  @@index([companyId])
}

enum ServiceChargeType {
  PER_PERSON
  PER_DAY
  PACK
}

model Service {
  id           Int                  @id @default(autoincrement())
  name         String
  price        Decimal              @db.Decimal(10, 2)
  chargeType   ServiceChargeType    @default(PACK)
  isActive     Boolean              @default(true)
  companyId    Int
  createdAt    DateTime             @default(now())
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservations ReservationService[]

  @@unique([companyId, name])
  @@index([companyId])
}

enum ReservationStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Reservation {
  id           Int                @id @default(autoincrement())
  code         String             @unique
  roomId       Int
  guestId      Int
  companyId    Int
  checkIn      DateTime           @db.Date
  checkOut     DateTime           @db.Date
  persons      Int                @default(1)
  status       ReservationStatus  @default(RESERVED)
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  cancelledAt  DateTime?
  refundEligible Boolean          @default(false)
  refundAmount   Decimal?         @db.Decimal(10, 2)
  refunded       Boolean          @default(false)
  refundedAt     DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  room         Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest        Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payments     Payment[]
  services     ReservationService[]

  @@index([companyId, code])
  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@index([status])
}

model ReservationService {
  id            Int         @id @default(autoincrement())
  reservationId Int
  serviceId     Int
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 2)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([reservationId, serviceId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Payment {
  id            Int         @id @default(autoincrement())
  reservationId Int
  amount        Decimal     @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime    @default(now())
  reference     String?
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}