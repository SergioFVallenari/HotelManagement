generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String?
  typeId       Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  type         UserType @relation(fields: [typeId], references: [id])
}

enum UserRole {
  ADMIN
  RECEPCIONISTA
}

model UserType {
  id    Int      @id @default(autoincrement())
  role  UserRole @unique @default(RECEPCIONISTA)
  users User[]
}

model RoomType {
  id    Int    @id @default(autoincrement())
  name  String @unique
  rooms Room[]
}

model Room {
  id           Int           @id @default(autoincrement())
  number       String        @unique
  name         String?
  typeId       Int
  capacity     Int           @default(2)
  price        Decimal       @db.Decimal(10, 2)
  amenities    String[]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  type         RoomType      @relation(fields: [typeId], references: [id])
  reservations Reservation[]

  @@index([typeId])
}

model Guest {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String
  email        String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Service {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  price        Decimal              @db.Decimal(10, 2)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  reservations ReservationService[]
}

enum ReservationStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Reservation {
  id           Int                @id @default(autoincrement())
  code         String             @unique
  roomId       Int
  guestId      Int
  checkIn      DateTime           @db.Date
  checkOut     DateTime           @db.Date
  status       ReservationStatus  @default(RESERVED)
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  room         Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest        Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  payments     Payment[]
  services     ReservationService[]

  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@index([status])
}

model ReservationService {
  id            Int         @id @default(autoincrement())
  reservationId Int
  serviceId     Int
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 2)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([reservationId, serviceId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Payment {
  id            Int         @id @default(autoincrement())
  reservationId Int
  amount        Decimal     @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime    @default(now())
  reference     String?
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}