generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  bookingSlug String? @unique
  createdById Int?
  // Anticipo que se cobra de las reservas que llegan por el formulario de
  // WhatsApp: porcentaje del total de la estadia (se redondea a multiplos de
  // $10.000). 0 = el hotel no pide anticipo.
  bookingDepositPercent Int @default(20)
  whatsapp String?
  phone    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members     UserCompany[]
  roomTypes   RoomType[]
  rooms       Room[]
  guests      Guest[]
  services    Service[]
  reservations Reservation[]
  mpAccount   CompanyMpAccount?
  channelAccounts      ChannelAccount[]
  channelConversations ChannelConversation[]
  aiSetting   CompanyAiSetting?
  bookingLinks BookingLink[]
  bookingReceipts ReservationReceipt[]
  configPage Json @default("{}")
}

model CompanyAiSetting {
  companyId    Int      @id
  enabled      Boolean  @default(false)
  autoReply    Boolean  @default(true)
  instructions String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id         Int           @id @default(autoincrement())
  authUserId String?       @unique
  email      String        @unique
  name       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  companies  UserCompany[]
}

model UserCompany {
  userId      Int
  companyId   Int
  username    String
  typeId      Int
  isActive    Boolean  @default(true)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type        UserType @relation(fields: [typeId], references: [id])

  @@id([userId, companyId])
  @@unique([companyId, username])
  @@index([companyId])
  @@index([userId])
  @@index([typeId])
}

enum UserRole {
  ADMIN
  RECEPCIONISTA
  OWNER
}

model UserType {
  id    Int           @id @default(autoincrement())
  role  UserRole      @unique @default(RECEPCIONISTA)
  users UserCompany[]
}

model RoomType {
  id        Int      @id @default(autoincrement())
  name      String
  companyId Int
  rooms     Room[]
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId])
}

model Room {
  id           Int           @id @default(autoincrement())
  number       String
  name         String?
  typeId       Int
  companyId    Int
  capacity     Int           @default(2)
  maxExtraBeds Int           @default(0)
  price        Decimal       @db.Decimal(10, 2)
  pricingMode  RoomPricingMode @default(PER_NIGHT)
  amenities    String[]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  type         RoomType      @relation(fields: [typeId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  reservationRooms ReservationRoom[]
  bookingLinks BookingLink[]

  @@unique([companyId, number])
  @@index([typeId])
  @@index([companyId])
}

enum RoomPricingMode {
  PER_NIGHT
  PER_PERSON
}


model Guest {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String
  email        String
  companyId    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([companyId, email])
  @@index([companyId])
}

enum ServiceChargeType {
  PER_PERSON
  PER_DAY
  PACK
}

model Service {
  id           Int                  @id @default(autoincrement())
  name         String
  price        Decimal              @db.Decimal(10, 2)
  chargeType   ServiceChargeType    @default(PACK)
  isExtraBed   Boolean              @default(false)
  isActive     Boolean              @default(true)
  companyId    Int
  createdAt    DateTime             @default(now())
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservations ReservationService[]

  @@unique([companyId, name])
  @@index([companyId])
}

enum ReservationStatus {
  PENDING
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

// De donde salio la reserva: STAFF = cargada por el personal en el panel,
// PUBLIC_LINK = el huesped la mando por el formulario de WhatsApp (queda
// PENDING hasta que la recepcion verifica el comprobante).
enum ReservationSource {
  STAFF
  PUBLIC_LINK
}

model Reservation {
  id           Int                @id @default(autoincrement())
  code         String             @unique
  roomId       Int
  guestId      Int
  companyId    Int
  checkIn      DateTime           @db.Date
  checkOut     DateTime           @db.Date
  persons      Int                @default(1)
  extraBeds    Int                @default(0)
  roomPrice    Decimal?           @db.Decimal(10, 2)
  roomPricingMode RoomPricingMode?
  status       ReservationStatus  @default(RESERVED)
  source       ReservationSource  @default(STAFF)
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  cancelledAt  DateTime?
  refundEligible Boolean          @default(false)
  refundAmount   Decimal?         @db.Decimal(10, 2)
  refunded       Boolean          @default(false)
  refundedAt     DateTime?
  mpOrderId      String?            @unique
  mpCheckoutUrl  String?
  mpExpectedAmount Decimal?         @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  room         Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest        Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payments     Payment[]
  services     ReservationService[]
  receipt      ReservationReceipt?
  bookingLink  BookingLink?
  rooms        ReservationRoom[]

  @@index([companyId, code])
  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@index([status])
  @@index([companyId, source])
}

model ReservationRoom {
  id              Int             @id @default(autoincrement())
  reservationId   Int
  roomId          Int
  persons         Int
  extraBeds       Int             @default(0)
  roomPrice       Decimal         @db.Decimal(10, 2)
  roomPricingMode RoomPricingMode
  reservation     Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room            Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([reservationId, roomId])
  @@index([roomId])
}

// Solicitud de reserva preparada por la recepcion y compartida por WhatsApp.
// El link es un token opaco: el huesped lo abre, ve la cotizacion congelada,
// completa sus datos y sube el comprobante. Al enviarse, la reserva nace
// PENDING y el link queda COMPLETED (de ahi el estado unico por link).
enum BookingLinkStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model BookingLink {
  id            Int               @id @default(autoincrement())
  token         String            @unique
  companyId     Int
  roomId        Int
  checkIn       DateTime          @db.Date
  checkOut      DateTime          @db.Date
  persons       Int               @default(1)
  extraBeds     Int               @default(0)
  roomPrice     Decimal?          @db.Decimal(10, 2)
  roomPricingMode RoomPricingMode?
  // Snapshot de los servicios cotizados: { serviceId, name, quantity,
  // personsCovered, unitPrice, lineTotal }.
  services      Json              @default("[]")
  rooms         Json              @default("[]")
  total         Decimal           @db.Decimal(10, 2)
  deposit       Decimal           @db.Decimal(10, 2)
  status        BookingLinkStatus @default(OPEN)
  reservationId Int?              @unique
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room          Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservation   Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

// Comprobante de pago que subio el huesped por el formulario de WhatsApp.
// El archivo vive en Supabase Storage (bucket privado); aca queda solo la
// metadata y el path para pedir una URL firmada.
model ReservationReceipt {
  id            Int         @id @default(autoincrement())
  companyId     Int
  reservationId Int         @unique
  storagePath   String
  fileName      String
  mimeType      String
  size          Int
  // Referencia de la transferencia que escribio el huesped (opcional).
  externalRef   String?
  createdAt     DateTime    @default(now())
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ReservationService {
  id            Int         @id @default(autoincrement())
  reservationId Int
  serviceId     Int
  quantity      Int         @default(1)
  personsCovered Int?
  unitPrice     Decimal     @db.Decimal(10, 2)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([reservationId, serviceId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MERCADOPAGO
}

model Payment {
  id            Int         @id @default(autoincrement())
  reservationId Int
  amount        Decimal     @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime    @default(now())
  reference     String?
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@unique([reference])
}

model CompanyMpAccount {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  mpUserId              String
  mpEmail               String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  connectedAt           DateTime @default(now())
  lastRefreshedAt       DateTime @default(now())
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum ChannelType {
  INSTAGRAM
  FACEBOOK
  AIRBNB
}

enum ChannelAccountStatus {
  ACTIVE
  REVOKED
  EXPIRED
  ERROR
}

model ChannelAccount {
  id                String               @id @default(cuid())
  companyId         Int
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel           ChannelType
  externalAccountId String
  handle            String?
  displayName       String?
  accessTokenEnc    String?              @db.Text
  accessTokenIv     String?
  refreshTokenEnc   String?              @db.Text
  refreshTokenIv    String?
  tokenExpiresAt    DateTime?
  scopes            String?
  status            ChannelAccountStatus @default(ACTIVE)
  metadata          Json?
  connectedAt       DateTime             @default(now())
  lastRefreshedAt   DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  conversations     ChannelConversation[]

  @@unique([companyId, channel])
  @@unique([channel, externalAccountId])
  @@index([companyId])
}

enum ChannelDirection {
  IN
  OUT
}

enum ChannelMessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
  DELETED
}

enum ChannelContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STORY
  SHARE
  REACTION
  SYSTEM
}

model ChannelConversation {
  id                 String           @id @default(cuid())
  companyId          Int
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel            ChannelType
  accountId          String
  account            ChannelAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalThreadId   String
  participantId      String
  participantHandle  String?
  participantName    String?
  participantAvatar  String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastInboundAt      DateTime?
  unreadCount        Int                @default(0)
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  messages           ChannelMessage[]

  @@unique([accountId, externalThreadId])
  @@index([companyId, lastMessageAt])
  @@index([companyId, channel, lastMessageAt])
}

model ChannelMessage {
  id                String                  @id @default(cuid())
  companyId         Int
  conversationId    String
  conversation      ChannelConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalMessageId String                  @unique
  direction         ChannelDirection
  contentType       ChannelContentType      @default(TEXT)
  text              String?                 @db.Text
  attachments       Json?
  replyToExternalId String?
  status            ChannelMessageStatus    @default(RECEIVED)
  error             String?
  sentAt            DateTime
  createdAt         DateTime                @default(now())

  @@index([conversationId, sentAt])
  @@index([companyId, sentAt])
}
