# URL del backend (obligatoria; en development http://localhost:3000).
# Sin esta variable el fetch falla contra "undefined/api".
VITE_URL_BACKEND=http://localhost:3000

# Muestra el boton "Crear usuario" + formulario de registro en el login.
# Default: oculto (sistema cerrado; el registro sigue disponible por API).
# Coordinar con REGISTER_KEY del backend:
#   cerrado -> VITE_ALLOW_REGISTER=false + REGISTER_KEY seteada
#   abierto -> VITE_ALLOW_REGISTER=true  + REGISTER_KEY vacia
VITE_ALLOW_REGISTER=false
